{
  "name": "@quajs/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "node scripts/prepare-content.mjs && svedocs dev",
    "build": "node scripts/prepare-content.mjs && svedocs build --mode static && node scripts/finalize-build.mjs",
    "preview": "svedocs preview",
    "check": "node scripts/prepare-content.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svedocs check --strict",
    "typecheck": "pnpm check",
    "test:smoke": "node scripts/smoke.mjs",
    "test:markdown": "node --experimental-strip-types --test scripts/markdown.test.mjs",
    "deploy:check": "wrangler deploy --dry-run --no-autoconfig",
    "deploy": "pnpm check && pnpm build && wrangler deploy --no-autoconfig",
    "dev:worker": "wrangler dev --port 4176"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.2.8",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "svedocs": "0.2.1",
    "svelte": "^5.55.9",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "playwright": "^1.59.1",
    "shiki": "4.0.2",
    "svedocs-cli": "0.2.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "wrangler": "4.136.1"
  },
  "packageManager": "pnpm@12.3.4"
}

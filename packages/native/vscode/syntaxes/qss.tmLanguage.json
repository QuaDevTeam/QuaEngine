{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qua Style",
  "scopeName": "source.qss",
  "fileTypes": ["qss"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#at-rules" },
    { "include": "#selectors" },
    { "include": "#properties" },
    { "include": "#values" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.qss"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.qss"
        }
      ]
    },
    "at-rules": {
      "match": "@(tokens|theme|font-face|media|supports)\\b",
      "captures": {
        "0": { "name": "keyword.control.at-rule.qss" }
      }
    },
    "selectors": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(::part\\([A-Za-z_][\\w-]*\\))?",
          "captures": {
            "1": { "name": "entity.name.type.selector.qss" },
            "2": { "name": "entity.other.attribute-name.part.qss" }
          }
        },
        {
          "match": "([.#])([A-Za-z_][\\w-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.selector.qss" },
            "2": { "name": "entity.other.attribute-name.selector.qss" }
          }
        },
        {
          "match": ":(hover|active|focus|focus-visible|disabled|enabled|checked|selected|open)\\b",
          "name": "entity.other.attribute-name.pseudo-class.qss"
        }
      ]
    },
    "properties": {
      "match": "\\b([a-z][a-z-]*)(?=\\s*:)",
      "captures": {
        "1": { "name": "support.type.property-name.qss" }
      }
    },
    "values": {
      "patterns": [
        {
          "match": "#[0-9A-Fa-f]{3,8}\\b",
          "name": "constant.other.color.rgb-value.qss"
        },
        {
          "match": "\\b-?\\d+(?:\\.\\d+)?(?:px|%|fr)?\\b",
          "name": "constant.numeric.qss"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.qss"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.qss"
        },
        {
          "match": "\\b(token|asset)\\s*\\(",
          "name": "support.function.value.qss"
        }
      ]
    }
  }
}

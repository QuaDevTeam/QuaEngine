{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qua UI",
  "scopeName": "source.qui",
  "fileTypes": ["qui"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#directives" },
    { "include": "#components" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.qui"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.qui"
        }
      ]
    },
    "imports": {
      "match": "^\\s*(import)\\s+(style|tokens|component)\\s+([\"'])([^\"']+)(\\3)\\s*;?",
      "captures": {
        "1": { "name": "keyword.control.import.qui" },
        "2": { "name": "storage.type.import-kind.qui" },
        "3": { "name": "punctuation.definition.string.begin.qui" },
        "4": { "name": "string.quoted.import-path.qui" },
        "5": { "name": "punctuation.definition.string.end.qui" }
      }
    },
    "directives": {
      "match": "\\b(if|else-if|else|for|key|show|slot|class|style|id|action)\\b\\s*:",
      "captures": {
        "1": { "name": "keyword.other.directive.qui" }
      }
    },
    "components": {
      "match": "\\b([A-Z][A-Za-z0-9_]*)(?=\\s*(?:\\.|\\(|\\{|$))",
      "captures": {
        "1": { "name": "entity.name.type.component.qui" }
      }
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.qui",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.qui"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.qui",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.qui"
            }
          ]
        }
      ]
    },
    "numbers": {
      "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.qui"
    }
  }
}

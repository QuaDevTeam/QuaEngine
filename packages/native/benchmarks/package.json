{
  "name": "@quajs/native-benchmarks",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic smoke benchmarks for QuaEngine native authoring and renderer tooling",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/native/benchmarks"
  },
  "keywords": [
    "quaengine",
    "native",
    "benchmark",
    "qui",
    "qss"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --logLevel error",
    "bench:smoke": "vite build --logLevel silent && node dist/bench-smoke.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/native-language-server": "workspace:*",
    "@quajs/native-ui-compiler": "workspace:*"
  }
}

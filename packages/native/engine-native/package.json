{
  "name": "@quajs/engine-native",
  "type": "module",
  "version": "0.1.0",
  "description": "Native QuaEngine host plugin and compatibility helpers for QuickJS + wgpu runtime",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/native/engine-native"
  },
  "keywords": [
    "quaengine",
    "native",
    "engine",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/native-contracts": "workspace:*"
  },
  "devDependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/character": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-background": "workspace:*",
    "@quajs/script-compiler": "workspace:*",
    "typescript": "catalog:"
  }
}

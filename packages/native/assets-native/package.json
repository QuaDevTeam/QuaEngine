{
  "name": "@quajs/assets-native",
  "type": "module",
  "version": "0.1.0",
  "description": "Native QuaAssets adapter backed by the QuaEngine Rust native host",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/native/assets-native"
  },
  "keywords": [
    "quaengine",
    "assets",
    "native",
    "adapter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/native-contracts": "workspace:*"
  }
}

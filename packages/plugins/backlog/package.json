{
  "name": "@quajs/plugin-backlog",
  "type": "module",
  "version": "0.1.0",
  "description": "Backlog projection and rewind intents for QuaEngine",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/plugins/backlog"
  },
  "keywords": [
    "quaengine",
    "plugin",
    "backlog",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./script-compiler": {
      "types": "./dist/script-compiler.d.ts",
      "import": "./dist/script-compiler.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/pipeline": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-settings": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quajs/plugin-audio": {
      "optional": true
    },
    "@quajs/plugin-settings": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/engine": "workspace:*",
    "@quajs/pipeline": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-settings": "workspace:*",
    "@quajs/store": "workspace:*"
  },
  "quajs": {
    "type": "plugin",
    "category": "ui",
    "description": "Backlog recording, retention, rewind, and voice replay projection",
    "renderer": {
      "web": "@quajs/renderer-web/plugins/backlog",
      "vue": "@quajs/renderer-vue/plugins/backlog",
      "cocos": "@quajs/renderer-cocos/plugins/backlog"
    },
    "decorators": {
      "Backlog": {
        "function": "setBacklogPolicyWithEngine",
        "module": "@quajs/plugin-backlog"
      },
      "NoBacklog": {
        "function": "setBacklogPolicyWithEngine",
        "module": "@quajs/plugin-backlog"
      }
    }
  }
}

{
  "name": "@quajs/plugin-animation",
  "type": "module",
  "version": "0.1.0",
  "description": "Cross-plugin timeline animation APIs and QuaScript decorators for QuaEngine",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "plugin",
    "animation",
    "timeline",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script-compiler": {
      "types": "./dist/script-compiler.d.ts",
      "import": "./dist/script-compiler.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "dependencies": {
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "quajs": {
    "type": "plugin",
    "category": "visual",
    "description": "Cross-plugin timeline animation APIs and QuaScript decorators",
    "decorators": {
      "DefineAnimation": {
        "function": "registerAnimationWithEngine",
        "module": "@quajs/plugin-animation"
      },
      "Timeline": {
        "function": "playTimelineWithEngine",
        "module": "@quajs/plugin-animation"
      },
      "Key": {
        "function": "defineAnimationKeyframe",
        "module": "@quajs/plugin-animation"
      },
      "PlayAnimation": {
        "function": "playAnimationWithEngine",
        "module": "@quajs/plugin-animation"
      }
    },
    "language": {
      "decorators": {
        "DefineAnimation": {
          "description": "Define a reusable animation timeline",
          "args": [
            {
              "name": "animationId",
              "detail": "Animation id"
            }
          ]
        },
        "Timeline": {
          "description": "Play an inline animation timeline",
          "args": [
            {
              "name": "duration",
              "detail": "Timeline duration in milliseconds"
            }
          ]
        },
        "Key": {
          "description": "Add a timeline keyframe",
          "args": [
            {
              "name": "targetOrProperty",
              "values": ["self", "background", "dialogue", "choice"],
              "detail": "Animation target or property"
            },
            {
              "name": "property",
              "values": ["x", "y", "scale", "rotation", "opacity"],
              "detail": "Animated property"
            }
          ]
        },
        "PlayAnimation": {
          "description": "Play a reusable animation",
          "args": [
            {
              "name": "animationId",
              "detail": "Animation id"
            }
          ]
        }
      }
    }
  }
}

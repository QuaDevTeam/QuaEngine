{
  "name": "@quajs/plugin-animation",
  "type": "module",
  "version": "0.1.0",
  "description": "Cross-plugin timeline animation APIs and QuaScript decorators for QuaEngine",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "plugin",
    "animation",
    "timeline",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script-compiler": {
      "types": "./dist/script-compiler.d.ts",
      "import": "./dist/script-compiler.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "dependencies": {
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "quajs": {
    "type": "plugin",
    "category": "visual",
    "description": "Cross-plugin timeline animation APIs and QuaScript decorators",
    "decorators": {
      "DefineAnimation": {
        "function": "registerAnimationWithEngine",
        "module": "@quajs/plugin-animation"
      },
      "Timeline": {
        "function": "playTimelineWithEngine",
        "module": "@quajs/plugin-animation"
      },
      "Key": {
        "function": "defineAnimationKeyframe",
        "module": "@quajs/plugin-animation"
      },
      "PlayAnimation": {
        "function": "playAnimationWithEngine",
        "module": "@quajs/plugin-animation"
      }
    }
  }
}

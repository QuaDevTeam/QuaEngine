{
  "name": "@quajs/plugin-background",
  "type": "module",
  "version": "0.1.0",
  "description": "Background APIs and QuaScript decorators for QuaEngine",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "plugin",
    "background",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script-compiler": {
      "types": "./dist/script-compiler.d.ts",
      "import": "./dist/script-compiler.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "dependencies": {
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "quajs": {
    "type": "plugin",
    "category": "visual",
    "description": "Background image, video, layered background, and transition APIs",
    "decorators": {
      "SetBackground": {
        "function": "setBackgroundWithEngine",
        "module": "@quajs/plugin-background"
      },
      "ClearBackground": {
        "function": "clearBackgroundWithEngine",
        "module": "@quajs/plugin-background"
      },
      "VideoBackground": {
        "function": "setVideoBackgroundWithEngine",
        "module": "@quajs/plugin-background"
      },
      "SetLayeredBackground": {
        "function": "setLayeredBackgroundWithEngine",
        "module": "@quajs/plugin-background"
      },
      "BackgroundLayer": {
        "function": "addBackgroundLayerWithEngine",
        "module": "@quajs/plugin-background"
      },
      "RemoveBackgroundLayer": {
        "function": "removeBackgroundLayerWithEngine",
        "module": "@quajs/plugin-background"
      },
      "ClearBackgroundLayers": {
        "function": "clearBackgroundLayersWithEngine",
        "module": "@quajs/plugin-background"
      },
      "BackgroundTransition": {
        "function": "transitionBackgroundWithEngine",
        "module": "@quajs/plugin-background"
      },
      "BackgroundLayerTransition": {
        "function": "transitionBackgroundLayerWithEngine",
        "module": "@quajs/plugin-background"
      }
    },
    "language": {
      "decorators": {
        "SetBackground": {
          "description": "Set an image background",
          "args": [
            {
              "name": "asset",
              "assetRoots": ["assets/images", "assets/backgrounds"],
              "assetExtensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif"],
              "detail": "Background image asset"
            },
            {
              "name": "transition",
              "values": ["instant", "fade", "crossfade", "wipe"],
              "detail": "Background transition type"
            }
          ]
        },
        "VideoBackground": {
          "description": "Set a video background",
          "args": [
            {
              "name": "asset",
              "assetRoots": ["assets/video", "assets/videos"],
              "assetExtensions": [".mp4", ".webm", ".mov"],
              "detail": "Video asset"
            }
          ]
        },
        "SetLayeredBackground": {
          "description": "Enable layered background mode",
          "args": [
            {
              "name": "transition",
              "values": ["instant", "fade", "crossfade", "wipe"],
              "detail": "Background transition type"
            }
          ]
        },
        "BackgroundLayer": {
          "description": "Add or replace a background layer",
          "args": [
            {
              "name": "layerId",
              "detail": "Layer id"
            },
            {
              "name": "asset",
              "assetRoots": ["assets/images", "assets/backgrounds"],
              "assetExtensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif"],
              "detail": "Layer image asset"
            }
          ]
        },
        "BackgroundTransition": {
          "description": "Transition the current background",
          "args": [
            {
              "name": "transition",
              "values": ["instant", "fade", "crossfade", "wipe"],
              "detail": "Background transition type"
            }
          ]
        },
        "BackgroundLayerTransition": {
          "description": "Transition a layered background item",
          "args": [
            {
              "name": "layerId",
              "detail": "Layer id"
            },
            {
              "name": "transition",
              "values": ["instant", "fade", "crossfade", "wipe"],
              "detail": "Background transition type"
            }
          ]
        }
      }
    }
  }
}

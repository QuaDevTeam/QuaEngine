{
  "name": "@quajs/plugin-asset-loading",
  "type": "module",
  "version": "0.1.0",
  "description": "Engine-owned asset loading scenes and retry lifecycle",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/plugins/asset-loading"
  },
  "keywords": [
    "quaengine",
    "plugin",
    "assets",
    "loading"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/engine": "workspace:*"
  },
  "devDependencies": {
    "@quajs/render-core": "workspace:*",
    "@quajs/assets": "workspace:*",
    "@quajs/engine": "workspace:*",
    "@quajs/store": "workspace:*"
  },
  "quajs": {
    "type": "plugin",
    "category": "ui",
    "description": "Engine-owned asset loading scenes and retry lifecycle"
  }
}

{
  "name": "@quajs/quack",
  "type": "module",
  "version": "0.1.0",
  "description": "Assets bundler for QuaEngine",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/build/quack"
  },
  "keywords": [
    "bundler",
    "assets",
    "game",
    "quaengine",
    "localization",
    "compression"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./qpk-reader": {
      "types": "./dist/qpk-reader.d.ts",
      "import": "./dist/qpk-reader.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "quack": "./bin/quack.cjs"
  },
  "files": [
    "bin",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/logger": "workspace:*",
    "@quajs/utils": "workspace:*"
  },
  "dependencies": {
    "@quajs/native-contracts": "workspace:*",
    "@quajs/script-compiler": "workspace:*",
    "commander": "catalog:",
    "glob": "catalog:",
    "lzma-native": "catalog:",
    "mediabunny": "catalog:",
    "mime-types": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "yauzl": "catalog:",
    "yazl": "catalog:"
  },
  "devDependencies": {}
}

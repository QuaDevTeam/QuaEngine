{
  "name": "@quajs/project-inspector",
  "type": "module",
  "version": "0.1.0",
  "description": "Read-only project, story tree, QPK, and asset lineage inspector for QuaEngine.",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "quascript",
    "inspector",
    "qpk",
    "story-tree"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/plugin-discovery": "workspace:*",
    "@quajs/quack": "workspace:*",
    "@quajs/script-compiler": "workspace:*"
  }
}

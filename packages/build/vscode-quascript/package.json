{
  "publisher": "quajs",
  "name": "quascript",
  "displayName": "QuaScript",
  "type": "module",
  "version": "0.1.0",
  "description": "TypeScript-first language support for QuaScript .qs files in QuaEngine.",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "homepage": "https://github.com/QuaDevTeam/QuaEngine#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/build/vscode-quascript"
  },
  "bugs": {
    "url": "https://github.com/QuaDevTeam/QuaEngine/issues"
  },
  "preview": true,
  "qna": false,
  "keywords": [
    "galgame",
    "language-server",
    "quaengine",
    "quascript",
    "typescript",
    "visual-novel"
  ],
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "node": ">=20",
    "vscode": "^1.118.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:quascript",
    "onView:quascript.storyTree",
    "onView:quascript.qpkExplorer",
    "onView:quascript.assetLineage",
    "onView:quascript.storyPointInspector",
    "onView:quascript.packageHealth",
    "onCommand:quascript.refreshInspector",
    "onCommand:quascript.openStoryGraph",
    "onCommand:quascript.formatDocument",
    "onCommand:quascript.fixAll",
    "onCommand:quascript.restartLanguageServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quascript",
        "aliases": [
          "QuaScript",
          "quascript"
        ],
        "extensions": [
          ".qs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quascript",
        "scopeName": "source.quascript",
        "path": "./syntaxes/quascript.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.inline.typescript": "typescript"
        }
      }
    ],
    "snippets": [
      {
        "language": "quascript",
        "path": "./snippets/quascript.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quascript",
          "title": "QuaScript",
          "icon": "media/quascript.svg"
        }
      ]
    },
    "views": {
      "quascript": [
        {
          "id": "quascript.storyTree",
          "name": "Story Tree"
        },
        {
          "id": "quascript.qpkExplorer",
          "name": "QPK Explorer"
        },
        {
          "id": "quascript.assetLineage",
          "name": "Asset Lineage"
        },
        {
          "id": "quascript.storyPointInspector",
          "name": "Story Point Inspector"
        },
        {
          "id": "quascript.packageHealth",
          "name": "Package Health"
        }
      ]
    },
    "commands": [
      {
        "command": "quascript.formatDocument",
        "title": "QuaScript: Format Document",
        "icon": "$(wand)"
      },
      {
        "command": "quascript.fixAll",
        "title": "QuaScript: Fix All Auto-fixable Problems",
        "icon": "$(tools)"
      },
      {
        "command": "quascript.restartLanguageServer",
        "title": "QuaScript: Restart Language Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "quascript.refreshInspector",
        "title": "QuaScript: Refresh Project Inspector",
        "icon": "$(refresh)"
      },
      {
        "command": "quascript.openStoryGraph",
        "title": "QuaScript: Open Story Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "quascript.filterToPackage",
        "title": "Filter To Package",
        "icon": "$(filter)"
      },
      {
        "command": "quascript.clearPackageFilter",
        "title": "Clear Package Filter",
        "icon": "$(filter-filled)"
      },
      {
        "command": "quascript.inspectStoryPoint",
        "title": "Inspect Story Point",
        "icon": "$(inspect)"
      },
      {
        "command": "quascript.revealPackage",
        "title": "Reveal Package",
        "icon": "$(package)"
      },
      {
        "command": "quascript.openSource",
        "title": "Open Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "quascript.copyRef",
        "title": "Copy Reference",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quascript.refreshInspector",
          "when": "view == quascript.storyTree || view == quascript.qpkExplorer || view == quascript.assetLineage || view == quascript.storyPointInspector || view == quascript.packageHealth",
          "group": "navigation"
        },
        {
          "command": "quascript.openStoryGraph",
          "when": "view == quascript.storyTree",
          "group": "navigation"
        },
        {
          "command": "quascript.clearPackageFilter",
          "when": "view == quascript.storyTree && quascript.packageFilterActive",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "quascript.inspectStoryPoint",
          "when": "view == quascript.storyTree && (viewItem == node || viewItem == entry || viewItem == label)",
          "group": "inline"
        },
        {
          "command": "quascript.revealPackage",
          "when": "view == quascript.storyTree && (viewItem == package || viewItem == scene || viewItem == node || viewItem == entry || viewItem == label)",
          "group": "inline"
        },
        {
          "command": "quascript.revealPackage",
          "when": "view == quascript.assetLineage && (viewItem == assetPackage || viewItem == assetLineage)",
          "group": "inline"
        },
        {
          "command": "quascript.filterToPackage",
          "when": "view == quascript.storyTree && (viewItem == package || viewItem == scene || viewItem == node || viewItem == entry || viewItem == label)",
          "group": "navigation"
        },
        {
          "command": "quascript.openSource",
          "when": "view == quascript.storyTree || view == quascript.qpkExplorer || view == quascript.assetLineage",
          "group": "navigation"
        },
        {
          "command": "quascript.copyRef",
          "when": "view == quascript.storyTree || view == quascript.qpkExplorer || view == quascript.assetLineage",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "QuaScript",
      "properties": {
        "quascript.decorators.autoCollect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically collect decorators from discovered Qua packages. Disable this to require explicit registration or local imports in each .qs file."
        },
        "quascript.decorators.mappings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "required": [
              "function",
              "module"
            ],
            "properties": {
              "function": {
                "type": "string"
              },
              "module": {
                "type": "string"
              }
            }
          },
          "description": "Explicit QuaScript decorator mappings merged into the compiler and language server."
        },
        "quascript.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable QuaScript lint diagnostics."
        },
        "quascript.lint.rules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "warning",
              "error",
              "info"
            ]
          },
          "description": "Override QuaScript lint rule severities by diagnostic code."
        },
        "quascript.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable QuaScript document formatting."
        },
        "quascript.format.maxBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Maximum consecutive blank lines preserved by the QuaScript formatter."
        },
        "quascript.format.insertFinalNewline": {
          "type": "boolean",
          "default": true,
          "description": "Insert a final newline when formatting QuaScript files."
        },
        "quascript.files.include": {
          "type": "array",
          "default": [
            "**/*.qs"
          ],
          "items": {
            "type": "string"
          },
          "description": "QuaScript file include patterns used by tooling."
        },
        "quascript.files.exclude": {
          "type": "array",
          "default": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            ".qua/**",
            "coverage/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "QuaScript file exclude patterns used by tooling."
        }
      }
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "vscode:package": "pnpm run build && node scripts/run-vsce.mjs package --no-dependencies --out dist/quascript-${npm_package_version}.vsix",
    "vscode:publish": "pnpm run build && node scripts/run-vsce.mjs publish --no-dependencies"
  },
  "devDependencies": {
    "@quajs/language-server": "workspace:*",
    "@quajs/project-inspector": "workspace:*",
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "vscode-languageclient": "catalog:"
  }
}

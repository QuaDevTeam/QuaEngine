{
  "Typed Scope Script": {
    "prefix": "script-scope",
    "body": [
      "<script lang=\"ts\">",
      "export interface Scope {",
      "  ${1:playerName}: ${2:string}",
      "}",
      "</script>",
      "",
      "${3:Yuki}: ${4:Hello \\${scope.playerName}!}"
    ],
    "description": "Create a typed QuaScript scope"
  },
  "Dialogue Line": {
    "prefix": "say",
    "body": [
      "${1:Yuki}: ${2:Hello!}"
    ],
    "description": "QuaScript dialogue line"
  },
  "Choice Decorator": {
    "prefix": "choice",
    "body": [
      "@Choice('${1:Continue}', node('${2:next}'), {",
      "  when: ${3:scope.unlocked},",
      "  unavailable: { mode: 'disabled', reason: '${4:Locked}' },",
      "  presentation: { thumbnail: image('${5:story/thumb.png}') }",
      "})"
    ],
    "description": "Canonical QuaScript choice decorator"
  },
  "Choice Line": {
    "prefix": "choice-line",
    "body": [
      "- ${1:Continue} -> ${2:next} if ${3:scope.unlocked}"
    ],
    "description": "QuaScript choice sugar line"
  }
}

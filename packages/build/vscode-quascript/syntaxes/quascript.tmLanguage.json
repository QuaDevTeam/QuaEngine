{
  "scopeName": "source.quascript",
  "patterns": [
    { "include": "#script" },
    { "include": "#decorator" },
    { "include": "#choice" },
    { "include": "#dialogue" },
    { "include": "#interpolation" }
  ],
  "repository": {
    "script": {
      "begin": "(<script\\b[^>]*lang=[\"']ts[\"'][^>]*>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.quascript" }
      },
      "end": "(</script>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.quascript" }
      },
      "name": "meta.embedded.block.typescript",
      "patterns": [
        { "include": "source.ts" }
      ]
    },
    "decorator": {
      "begin": "^\\s*(@)([A-Za-z_$][\\w$]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.decorator.quascript" },
        "2": { "name": "entity.name.function.decorator.quascript" }
      },
      "end": "$",
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "name": "meta.embedded.inline.typescript",
          "patterns": [
            { "include": "source.ts#expression" },
            { "include": "source.ts" }
          ]
        }
      ]
    },
    "choice": {
      "match": "^\\s*(-)\\s+(.+?)(?:\\s*(->)\\s*([^\\s]+))?(?:\\s+(if)\\s+(.+))?$",
      "captures": {
        "1": { "name": "punctuation.definition.choice.quascript" },
        "2": { "name": "string.unquoted.choice.quascript" },
        "3": { "name": "keyword.operator.choice-target.quascript" },
        "4": { "name": "entity.name.label.choice-target.quascript" },
        "5": { "name": "keyword.control.conditional.quascript" },
        "6": { "name": "meta.embedded.inline.typescript" }
      }
    },
    "dialogue": {
      "match": "^\\s*([^:@\\-][^:]*)(:)\\s*(.*)$",
      "captures": {
        "1": { "name": "entity.name.character.quascript" },
        "2": { "name": "punctuation.separator.dialogue.quascript" },
        "3": { "name": "string.unquoted.dialogue.quascript" }
      }
    },
    "interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "name": "meta.embedded.inline.typescript",
      "patterns": [
        { "include": "source.ts#expression" },
        { "include": "source.ts" }
      ]
    }
  }
}

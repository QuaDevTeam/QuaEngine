{
  "name": "@quajs/script-compiler",
  "type": "module",
  "version": "0.1.0",
  "description": "Compiler of QuaScript",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qua-script": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@quajs/character": "workspace:*",
    "@quajs/engine": "workspace:*",
    "@quajs/plugin-background": "workspace:*",
    "@quajs/plugin-discovery": "workspace:*",
    "@quajs/render-core": "workspace:*",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0"
  }
}

{
  "name": "@quajs/script-compiler",
  "type": "module",
  "version": "0.1.0",
  "description": "Compiler of QuaScript",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qua-script": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@babel/generator": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "@babel/types": "catalog:",
    "@quajs/character": "workspace:*",
    "@quajs/engine": "workspace:*",
    "@quajs/plugin-animation": "workspace:*",
    "@quajs/plugin-background": "workspace:*",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/babel__generator": "catalog:",
    "@types/babel__traverse": "catalog:"
  }
}

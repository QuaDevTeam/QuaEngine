#!/usr/bin/expect -f
# Feed the existing Apple app-specific password into the secure prompt, never argv/logs.
log_user 0
set timeout 120
set supplied 0
spawn -noecho xcrun notarytool store-credentials $env(QUA_EDITOR_NOTARY_PROFILE) --keychain $env(QUA_EDITOR_SIGNING_KEYCHAIN) --apple-id $env(APPLE_ID) --team-id $env(APPLE_TEAM_ID) --validate
expect {
  -re {(?i)password[^\r\n]*:} {
    if {$supplied} {
      catch {exec kill [exp_pid]}
      puts stderr "Notary credentials were rejected; no retry was attempted."
      exit 1
    }
    set supplied 1
    send -- "$env(APPLE_PASSWORD)\r"
    exp_continue
  }
  timeout {
    catch {exec kill [exp_pid]}
    puts stderr "Notary credential validation timed out."
    exit 1
  }
  eof {
    set result [wait]
    if {[lindex $result 2] != 0 || [lindex $result 3] != 0} {
      puts stderr "Notary credential validation failed; verify the Apple ID app-specific password and team."
      exit 1
    }
  }
}

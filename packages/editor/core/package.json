{
  "name": "@quajs/editor-core",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Host-independent QuaEngine authoring and preview contracts.",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/preview/runtime.d.ts",
      "import": "./dist/preview/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quajs/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quajs/assets-memory": "workspace:*",
    "@quajs/engine": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist/editor",
    "rootDir": "editor",
    "types": [
      "node"
    ]
  },
  "include": [
    "editor/**/*.ts"
  ],
  "exclude": [
    "editor/**/*.test.ts"
  ]
}

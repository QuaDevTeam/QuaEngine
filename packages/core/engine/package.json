{
  "name": "@quajs/engine",
  "type": "module",
  "version": "0.1.0",
  "description": "Core engine package",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/core/engine"
  },
  "keywords": [],
  "exports": {

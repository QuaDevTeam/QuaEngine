{
  "name": "@quajs/character",
  "type": "module",
  "version": "0.1.0",
  "description": "Character and dialogue APIs that update QuaEngine-owned state",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "character",
    "dialogue",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script-compiler": {
      "types": "./dist/script-compiler.d.ts",
      "import": "./dist/script-compiler.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "dependencies": {
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "quajs": {
    "type": "feature",
    "category": "visual",
    "description": "Character sprite, expression, and dialogue helpers for QuaEngine",
    "renderer": {
      "vue": "@quajs/renderer-vue/plugins/character"
    },
    "decorators": {
      "SetSprite": {
        "function": "sprite",
        "module": "@quajs/character"
      },
      "ShowCharacter": {
        "function": "show",
        "module": "@quajs/character"
      },
      "HideCharacter": {
        "function": "hide",
        "module": "@quajs/character"
      },
      "MoveCharacter": {
        "function": "move",
        "module": "@quajs/character"
      },
      "SetExpression": {
        "function": "expression",
        "module": "@quajs/character"
      }
    }
  }
}

{
  "name": "@quajs/character",
  "type": "module",
  "version": "0.1.0",
  "description": "Character and dialogue APIs that update QuaEngine-owned state",
  "author": "QuaDevTeam",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/core/character"
  },
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "character",
    "dialogue",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./script-compiler": {
      "types": "./dist/script-compiler.d.ts",
      "import": "./dist/script-compiler.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/plugin-animation": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@quajs/plugin-animation": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/types": "catalog:"
  },
  "devDependencies": {
    "@quajs/engine": "workspace:*",
    "@quajs/plugin-animation": "workspace:*",
    "@quajs/render-core": "workspace:*"
  },
  "quajs": {
    "type": "feature",
    "category": "visual",
    "description": "Character sprite, expression, and dialogue helpers for QuaEngine",
    "renderer": {
      "web": "@quajs/renderer-web/plugins/character",
      "vue": "@quajs/renderer-vue/plugins/character"
    },
    "decorators": {
      "SetSprite": {
        "function": "sprite",
        "module": "@quajs/character"
      },
      "ShowCharacter": {
        "function": "show",
        "module": "@quajs/character"
      },
      "HideCharacter": {
        "function": "hide",
        "module": "@quajs/character"
      },
      "MoveCharacter": {
        "function": "move",
        "module": "@quajs/character"
      },
      "SetExpression": {
        "function": "expression",
        "module": "@quajs/character"
      },
      "CharacterFade": {
        "function": "playCharacterFadeWithEngine",
        "module": "@quajs/character/animation"
      },
      "CharacterEnter": {
        "function": "playCharacterEnterWithEngine",
        "module": "@quajs/character/animation"
      },
      "CharacterExit": {
        "function": "playCharacterExitWithEngine",
        "module": "@quajs/character/animation"
      }
    },
    "language": {
      "decorators": {
        "SetSprite": {
          "description": "Set the current dialogue character sprite",
          "args": [
            {
              "name": "asset",
              "assetRoots": ["assets/characters"],
              "assetExtensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".json"],
              "detail": "Character asset"
            },
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            }
          ]
        },
        "ShowCharacter": {
          "description": "Show a character projection",
          "args": [
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            },
            {
              "name": "sprite",
              "assetRoots": ["assets/characters"],
              "assetExtensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".json"],
              "detail": "Character asset"
            }
          ]
        },
        "HideCharacter": {
          "description": "Hide a character projection",
          "args": [
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            }
          ]
        },
        "MoveCharacter": {
          "description": "Move a character projection",
          "args": [
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            }
          ]
        },
        "SetExpression": {
          "description": "Set a character expression",
          "args": [
            {
              "name": "expression",
              "detail": "Expression id"
            },
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            }
          ]
        },
        "CharacterFade": {
          "description": "Animate character opacity through @quajs/plugin-animation",
          "args": [
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            },
            {
              "name": "from",
              "detail": "Starting opacity"
            },
            {
              "name": "to",
              "detail": "Ending opacity"
            },
            {
              "name": "duration",
              "detail": "Duration in milliseconds"
            }
          ]
        },
        "CharacterEnter": {
          "description": "Animate a character entering through @quajs/plugin-animation",
          "args": [
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            },
            {
              "name": "direction",
              "values": ["left", "right", "top", "bottom"],
              "detail": "Entry direction"
            },
            {
              "name": "duration",
              "detail": "Duration in milliseconds"
            },
            {
              "name": "options",
              "detail": "Character motion options"
            }
          ]
        },
        "CharacterExit": {
          "description": "Animate a character exiting through @quajs/plugin-animation",
          "args": [
            {
              "name": "character",
              "characterNames": true,
              "detail": "Character name"
            },
            {
              "name": "direction",
              "values": ["left", "right", "top", "bottom"],
              "detail": "Exit direction"
            },
            {
              "name": "duration",
              "detail": "Duration in milliseconds"
            },
            {
              "name": "options",
              "detail": "Character motion options"
            }
          ]
        }
      }
    }
  }
}

{
  "name": "@quajs/renderer-vue",
  "type": "module",
  "version": "0.1.0",
  "description": "Stateless Vue renderer components for QuaEngine",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "vue",
    "renderer",
    "visual-novel"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/ui": {
      "types": "./dist/plugins/ui/index.d.ts",
      "import": "./dist/plugins/ui/index.js"
    },
    "./plugins/core": {
      "types": "./dist/plugins/core/index.d.ts",
      "import": "./dist/plugins/core/index.js"
    },
    "./plugins/background": {
      "types": "./dist/plugins/background/index.d.ts",
      "import": "./dist/plugins/background/index.js"
    },
    "./plugins/backlog": {
      "types": "./dist/plugins/backlog/index.d.ts",
      "import": "./dist/plugins/backlog/index.js"
    },
    "./plugins/sprite": {
      "types": "./dist/plugins/sprite/index.d.ts",
      "import": "./dist/plugins/sprite/index.js"
    },
    "./plugins/character": {
      "types": "./dist/plugins/character/index.d.ts",
      "import": "./dist/plugins/character/index.js"
    },
    "./plugins/effects": {
      "types": "./dist/plugins/effects/index.d.ts",
      "import": "./dist/plugins/effects/index.js"
    },
    "./plugins/fonts": {
      "types": "./dist/plugins/fonts/index.d.ts",
      "import": "./dist/plugins/fonts/index.js"
    },
    "./plugins/dialogue": {
      "types": "./dist/plugins/dialogue/index.d.ts",
      "import": "./dist/plugins/dialogue/index.js"
    },
    "./plugins/choices": {
      "types": "./dist/plugins/choices/index.d.ts",
      "import": "./dist/plugins/choices/index.js"
    },
    "./plugins/audio": {
      "types": "./dist/plugins/audio/index.d.ts",
      "import": "./dist/plugins/audio/index.js"
    },
    "./plugins/preset": {
      "types": "./dist/plugins/preset/index.d.ts",
      "import": "./dist/plugins/preset/index.js"
    },
    "./plugins/scene": {
      "types": "./dist/plugins/scene/index.d.ts",
      "import": "./dist/plugins/scene/index.js"
    },
    "./plugins/settings": {
      "types": "./dist/plugins/settings/index.d.ts",
      "import": "./dist/plugins/settings/index.js"
    },
    "./styles/base.scss": "./src/styles/base.scss",
    "./styles/default.scss": "./src/styles/default.scss"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/plugins",
    "src/styles"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/assets-web": "workspace:*",
    "@quajs/pipeline": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-backlog": "workspace:*",
    "@quajs/plugin-fonts": "workspace:*",
    "@quajs/plugin-settings": "workspace:*",
    "@quajs/plugin-sprite": "workspace:*",
    "@quajs/render-core": "workspace:*",
    "@quajs/renderer-web": "workspace:*",
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "@quajs/plugin-backlog": {
      "optional": true
    },
    "@quajs/plugin-fonts": {
      "optional": true
    },
    "@quajs/plugin-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/assets-web": "workspace:*",
    "@quajs/pipeline": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-backlog": "workspace:*",
    "@quajs/plugin-fonts": "workspace:*",
    "@quajs/plugin-settings": "workspace:*",
    "@quajs/plugin-sprite": "workspace:*",
    "@quajs/render-core": "workspace:*",
    "@quajs/renderer-web": "workspace:*",
    "vue": "catalog:"
  }
}

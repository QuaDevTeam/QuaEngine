{
  "name": "@quajs/assets-node",
  "type": "module",
  "version": "0.1.0",
  "description": "Node.js QuaAssets runtime adapter with fs/http fetcher and filesystem cache",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "assets",
    "node",
    "adapter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/assets": "workspace:*",
    "lzma-native": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

{
  "name": "@quajs/assets-memory",
  "type": "module",
  "version": "0.1.0",
  "description": "In-memory QuaAssets runtime adapter",
  "author": "QuaDevTeam",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/platform/assets-memory"

{
  "name": "@quajs/cocos-host",
  "type": "module",
  "version": "0.1.0",
  "description": "Host abstractions for QuaEngine Cocos runtime adapters",
  "author": "QuaDevTeam",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/platform/cocos-host"
  },
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "cocos",
    "host",
    "adapter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./creator": {
      "types": "./dist/creator.d.ts",
      "import": "./dist/creator.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  }
}

{
  "name": "@quajs/store-node",
  "type": "module",
  "version": "0.1.0",
  "description": "Node.js QuaStore storage adapter with encrypted .quastore files",
  "author": "QuaDevTeam",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "packages/platform/store-node"
  },
  "license": "Apache-2.0",
  "keywords": [
    "quaengine",
    "store",
    "node",
    "adapter",
    "quastore"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

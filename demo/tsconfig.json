{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@quajs/native-ui",
    "paths": {
      "@quajs/native-ui": ["../packages/native/ui-jsx/src/index.ts"],
      "@quajs/native-ui/jsx-runtime": ["../packages/native/ui-jsx/src/jsx-runtime.ts"],
      "@quajs/native-ui/jsx-dev-runtime": ["../packages/native/ui-jsx/src/jsx-dev-runtime.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.qs"
  ],
  "references": []
}

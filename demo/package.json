{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "QuaDevTeam",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuaDevTeam/QuaEngine.git",
    "directory": "demo"
  },
  "scripts": {
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:generate-backgrounds": "node scripts/generate-assets.mjs --only background",
    "assets:generate-cgs": "node scripts/generate-assets.mjs --only cg",
    "assets:generate-characters": "node scripts/generate-assets.mjs --only character",
    "assets:list": "node scripts/generate-assets.mjs --list",
    "assets:regenerate": "REGENERATE_ALL_ASSETS=1 node scripts/generate-assets.mjs",
    "assets:regenerate-backgrounds": "REGENERATE_BACKGROUNDS=1 node scripts/generate-assets.mjs",
    "assets:regenerate-cgs": "REGENERATE_CGS=1 node scripts/generate-assets.mjs",
    "assets:regenerate-characters": "REGENERATE_CHARACTERS=1 node scripts/generate-assets.mjs",
    "dev": "vite",
    "dev:web": "vite",
    "dev:native": "node --experimental-strip-types scripts/native-dev.mjs",
    "native:frame": "vite build --config vite.native.config.ts && node dist/native/dev-shell/frame.mjs",
    "native:smoke": "node --experimental-strip-types scripts/native-dev.mjs --smoke",
    "build": "vite build",
    "preview": "vite preview",
    "assets:build": "quack workspace:bundle --all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quajs/assets": "workspace:*",
    "@quajs/assets-web": "workspace:*",
    "@quajs/assets-memory": "workspace:*",
    "@quajs/character": "workspace:*",
    "@quajs/engine": "workspace:*",
    "@quajs/engine-native": "workspace:*",
    "@quajs/native-contracts": "workspace:*",
    "@quajs/pipeline": "workspace:*",
    "@quajs/plugin-animation": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-background": "workspace:*",
    "@quajs/plugin-backlog": "workspace:*",
    "@quajs/plugin-fonts": "workspace:*",
    "@quajs/plugin-gallery": "workspace:*",
    "@quajs/plugin-settings": "workspace:*",
    "@quajs/plugin-sprite": "workspace:*",
    "@quajs/render-core": "workspace:*",
    "@quajs/renderer-vue": "workspace:*",
    "@quajs/renderer-web": "workspace:*",
    "@quajs/security-web": "workspace:*",
    "@quajs/story-graph": "workspace:*",
    "@quajs/store-web": "workspace:*",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@quajs/quack": "workspace:*",
    "@quajs/script-compiler": "workspace:*",
    "@quajs/vite-plugin": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.7",
    "sass-embedded": "^1.70.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}

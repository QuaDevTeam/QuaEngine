    "@quajs/plugin-achievement": "workspace:*",
    "@quajs/plugin-animation": "workspace:*",
    "@quajs/plugin-asset-loading": "workspace:*",
    "@quajs/plugin-audio": "workspace:*",
    "@quajs/plugin-background": "workspace:*",
    "@quajs/plugin-backlog": "workspace:*",
    "@quajs/plugin-fonts": "workspace:*",
    "@quajs/plugin-gallery": "workspace:*",
    "@quajs/plugin-settings": "workspace:*",
    "@quajs/plugin-sprite": "workspace:*",
    "@quajs/render-core": "workspace:*",
    "@quajs/renderer-cocos": "workspace:*",
    "@quajs/renderer-godot": "workspace:*",
    "@quajs/renderer-scene": "workspace:*",
    "@quajs/renderer-vue": "workspace:*",
    "@quajs/renderer-web": "workspace:*",
    "@quajs/scene-host": "workspace:*",

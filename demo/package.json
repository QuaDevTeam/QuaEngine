  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:native": "node --experimental-strip-types scripts/native-dev.mjs",
    "native:e2e": "node --experimental-strip-types scripts/native-dev.mjs --e2e",
    "build": "vite build",
    "preview": "vite preview",
    "assets:build": "quack workspace:bundle --all",
    "typecheck": "tsc --noEmit",
    "test:story": "node scripts/story-smoke.mjs",
    "test:ui": "node scripts/ui-review.mjs",
    "test:quit": "node scripts/quit-smoke.mjs",
    "test:navigation": "node scripts/navigation-smoke.mjs",
    "test:backlog": "node --experimental-strip-types --test scripts/backlog-policy.test.mjs",
    "test:blur": "node scripts/blur-smoke.mjs",
    "test:asset-loading": "node scripts/asset-loading-smoke.mjs",
    "test:asset-loading:native": "node scripts/native-loading-smoke.mjs",
    "test:ui-surfaces": "vitest run --config vitest.config.ts",
    "build:cocos": "quack project build --target cocos --all",
    "build:cocos:mac": "node scripts/cocos-build.mjs mac",
    "test:cocos": "node scripts/cocos-review.mjs",
    "test:cocos:parity": "node scripts/cocos-parity.mjs",
    "test:cocos:surfaces": "node scripts/cocos-parity.mjs --quick --surfaces",
    "test:cocos:mac": "node scripts/cocos-native-review.mjs",
    "test:cocos:lifecycle": "node scripts/cocos-lifecycle.mjs",
    "test:cocos:media": "node scripts/cocos-media-review.mjs",
    "test:cocos:media:parity": "node scripts/cocos-media-review.mjs --require-parity",
    "media:fixtures": "node scripts/generate-media-fixtures.mjs",
    "build:godot": "node scripts/build-godot.mjs",
    "run:godot": "node scripts/run-godot.mjs",
    "edit:godot": "node scripts/run-godot.mjs --editor",
    "test:godot:native": "node scripts/godot-native-smoke.mjs",
    "test:godot:package": "node scripts/godot-package-smoke.mjs"
  },
  "dependencies": {
    "@quajs/assets": "workspace:*",
